<div>
    <div class="form-group">
        <label>{{localize "rit.startdice"}}</label>
        <select id="start-dice">
            {{#each startDice}}
                <option value={{this}} 
                    {{#if (eq selectedStart this)}}selected{{/if}}> {{this}}
                </option>
            {{/each}}
        </select>
    </div>
    <div class="form-group">
        <label>{{localize "rit.enddice"}}</label>
        <select id="end-dice">
            {{#each endDice}}
                <option value={{this}} 
                    {{#if (eq selectedEnd this)}}selected{{/if}}> {{this}}
                </option>
            {{/each}}
        </select>
    </div>
    {{#if differentDice}}
        <div class="form-group">
            <label>{{localize "rit.direction"}}</label>
            <select id="direction">
                <option value="up">{{localize "rit.increase"}}</option>
                <option value="down">{{localize "rit.decrese"}}</option>
            </select>
        </div>
    {{/if}}
</div>